{
  "info": {
    "name": "ReqRes API Tests",
    "description": "Assertions on status codes AND response body shape for https://reqres.in. Run with: npm run test:api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const key = pm.environment.get('api_key') || pm.collectionVariables.get('api_key');",
          "if (key) { pm.request.headers.upsert({ key: 'x-api-key', value: key }); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 GET list users (page 2) - 200 + body shape",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is JSON\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test(\"List envelope has pagination fields with correct types\", function () {",
              "    const j = pm.response.json();",
              "    pm.expect(j.page).to.equal(2);",
              "    pm.expect(j.per_page).to.be.a('number').and.above(0);",
              "    pm.expect(j.total).to.be.a('number');",
              "    pm.expect(j.total_pages).to.be.a('number').and.at.least(2);",
              "    pm.expect(j.data).to.be.an('array').and.not.empty;",
              "    pm.expect(j.data.length).to.be.at.most(j.per_page);",
              "});",
              "pm.test(\"Every user object has the expected shape\", function () {",
              "    const j = pm.response.json();",
              "    j.data.forEach(function (u) {",
              "        pm.expect(u).to.be.an('object');",
              "        pm.expect(u.id).to.be.a('number');",
              "        pm.expect(u.email).to.be.a('string').and.to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/);",
              "        pm.expect(u.first_name).to.be.a('string').and.not.empty;",
              "        pm.expect(u.last_name).to.be.a('string').and.not.empty;",
              "        pm.expect(u.avatar).to.be.a('string').and.to.match(/^https?:\\/\\//);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users?page=2",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "02 GET single user (id 2) - 200 + body shape",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Content-Type is JSON\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test(\"Body contains data object for user 2 with expected fields\", function () {",
              "    const j = pm.response.json();",
              "    pm.expect(j).to.have.property('data');",
              "    pm.expect(j.data.id).to.equal(2);",
              "    pm.expect(j.data).to.be.an('object');",
              "    pm.expect(j.data.id).to.be.a('number');",
              "    pm.expect(j.data.email).to.be.a('string').and.to.match(/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/);",
              "    pm.expect(j.data.first_name).to.be.a('string').and.not.empty;",
              "    pm.expect(j.data.last_name).to.be.a('string').and.not.empty;",
              "    pm.expect(j.data.avatar).to.be.a('string').and.to.match(/^https?:\\/\\//);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/2",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "2"
          ]
        }
      }
    },
    {
      "name": "03 POST create user - 201 + echoed fields + id/createdAt",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Content-Type is JSON\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test(\"Response echoes request data and adds id and createdAt\", function () {",
              "    const j = pm.response.json();",
              "    pm.expect(j.name).to.equal('morpheus');",
              "    pm.expect(j.job).to.equal('leader');",
              "    pm.expect(j.id).to.exist;",
              "    pm.expect(String(j.id)).to.match(/^\\d+$/);",
              "    pm.expect(j.createdAt).to.be.a('string');",
              "    pm.expect(isNaN(Date.parse(j.createdAt))).to.be.false;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"morpheus\",\n  \"job\": \"leader\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      }
    },
